PORT=3000
# 上线时必须配置独立的高强度账号与 scrypt 密码哈希；请勿将 .env 提交到代码仓库。
ADMIN_USERNAME=replace-with-admin-username
ADMIN_PASSWORD_HASH=scrypt:replace-with-salt:replace-with-128-character-hex-hash
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=reddot_website
DB_USERNAME=reddot_app
DB_PASSWORD=replace-with-strong-database-password
# 仅本地数据库管理/备份脚本使用，Java 应用不使用 root 账号。
MYSQL_ROOT_PASSWORD=replace-with-local-root-password
